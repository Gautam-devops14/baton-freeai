# Server
PORT=3000
# Provider order for planning and building (default nvidia,groq,google,openrouter,openai).
# BATON_PLANNER_ORDER / BATON_RELAY_ORDER override one stage only.
BATON_PROVIDER_ORDER=nvidia,groq,google,openrouter,openai
HOST=0.0.0.0
# Streaming timeouts: first chunk / gap mid-reply / whole call / first chunk for discovered models
BATON_PROVIDER_TIMEOUT_MS=30000
BATON_STREAM_IDLE_TIMEOUT_MS=20000
BATON_MAX_CALL_MS=180000
BATON_DISCOVERED_TIMEOUT_MS=15000
BATON_WORKSPACE_TTL_SECONDS=3600
# Run history (every prompt, its log and files) is stored here
BATON_DATA_DIR=data
BATON_HISTORY_MAX=500
# Pause before re-trying models that answered 503 "high demand" (last provider only)
BATON_OVERLOAD_RETRY_MS=2000
# Memory between runs: retired models / discovered replacements (24h), busy providers (5 min)
BATON_DEAD_MODEL_TTL_MS=86400000
BATON_BUSY_SKIP_MS=300000
BATON_KEY_REJECTED_SKIP_MS=600000
BATON_NO_CREDIT_SKIP_MS=3600000
BATON_NO_MODELS_SKIP_MS=3600000
# Longest wait for a short rate limit (e.g. Groq "try again in 7s") before giving up on a file
BATON_MAX_RATE_WAIT_MS=20000
# Rate limits resetting within this are waited out at once, before trying other providers
BATON_SHORT_RATE_WAIT_MS=8000

# Model overrides (defaults follow the spec). Provider API keys are NOT read
# from the environment: users supply their own per request (BYOK).
# Groq (the spec's qwen-2.5-coder-32b has been decommissioned)
GROQ_CODE_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_GENERAL_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# Gemini models, tried in order. If Google answers 404 / "no longer available"
# for one, Baton retries with the next before failing over to Groq.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# OpenAI (optional, paid, always tried last)
OPENAI_MODELS=gpt-5-mini,gpt-4.1-mini
# OpenRouter: only free (":free") models are ever used; daily cap -> skipped for an hour
# "openrouter/free" = OpenRouter's router to whatever model is free right now
OPENROUTER_CODE_MODELS=openrouter/free
OPENROUTER_GENERAL_MODELS=openrouter/free
BATON_DAILY_LIMIT_SKIP_MS=3600000
# NVIDIA NIM (free developer tier)
# (qwen3-coder-480b and gpt-oss-120b reached end of life on NVIDIA in 2026)
NVIDIA_CODE_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4.1-flash
NVIDIA_GENERAL_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4.1-flash,nvidia/nemotron-3-ultra-550b-a55b
# If every model in a list has been retired, Baton picks one from the provider's live /models list.
# Cost savers: full text of earlier files up to this many chars per step (outlines beyond),
# and follow-up edits as SEARCH/REPLACE blocks for files at least this big (BATON_EDIT_MODE=off to disable)
BATON_CONTEXT_FULL_CHARS=12000
BATON_EDIT_MIN_CHARS=1500
# Free-tier limits: tokens/minute caps (pacer), max pacer wait, cool-down waits (seconds) before giving up
BATON_TPM_LIMITS=groq=8000
BATON_PACER_MAX_WAIT_MS=45000
BATON_COOLDOWN_STEPS=30,60
